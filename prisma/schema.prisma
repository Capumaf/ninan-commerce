generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String                @id @default(cuid())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  name         String
  slug         String                @unique
  category     String?
  status       ProductStatus         @default(RESEARCHING)
  referenceUrl String?
  imageUrl     String?
  asin         String?
  amazonUrl    String?
  material     String?
  color        String?
  useCase      String?
  lengthCm     Float?
  widthCm      Float?
  heightCm     Float?
  weightGrams  Float?
  notes        String?
  amazonCosts  AmazonCostOperation[]
  inventory    Inventory?
  shipments    Shipment[]
  suppliers    Supplier[]
  campaigns   Campaign[]
  sellingPriceUsd Float?
}

model Supplier {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  productId        String
  supplierName     String
  contactName      String?
  contactEmail     String?
  sourceUrl        String?
  sourcePlatform   String?
  country          String?
  incoterm         Incoterm?
  unitPrice        Float?
  currency         String?        @default("USD")
  moq              Int?
  leadTimeDays     Int?
  unitsPerCarton   Int?
  cartonLengthCm   Float?
  cartonWidthCm    Float?
  cartonHeightCm   Float?
  cartonWeightKg   Float?
  sampleNotes      String?
  qualityNotes     String?
  negotiationNotes String?
  generalNotes     String?
  status           SupplierStatus @default(CONTACTED)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model AmazonCostOperation {
  id                     String   @id @default(cuid())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  productId              String
  label                  String?  @default("Base Estimate")
  referralFeeUsd         Float?
  fbaFeeUsd              Float?
  returnProcessingFeeUsd Float?
  targetAcosPct          Float?
  estimatedCpc           Float?
  estimatedCvr           Float?
  ppcCostPerUnitUsd      Float?
  freightPerUnitUsd      Float?
  customsBrokerFeeUsd    Float?
  isfFilingFeeUsd        Float?
  drayagePerUnitUsd      Float?
  cargoInsuranceUsd      Float?
  dutiesUsd              Float?
  dutyRatePct            Float?
  prepCostUsd            Float?
  labelingCostUsd        Float?
  inspectionUsd          Float?
  monthlyStorageUsd      Float?
  longtermStorageUsd     Float?
  sampleCostUsd          Float?
  photographyUsd         Float?
  miscCostUsd            Float?
  notes                  String?
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Inventory {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  productId        String    @unique
  unitsInFBA       Int       @default(0)
  unitsInTransit   Int       @default(0)
  unitsSold        Int       @default(0)
  unitsReserved    Int       @default(0)
  lastShipmentDate DateTime?
  reorderPoint     Int       @default(50)
  notes            String?
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Shipment {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  productId     String
  shipmentName  String
  amazonId      String
  destination   String
  status        ShipmentStatus @default(READY_TO_SHIP)
  unitsExpected Int
  unitsReceived Int            @default(0)
  shippedAt     DateTime?
  notes         String?
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  boxes         ShipmentBox[]
}

model ShipmentBox {
  id         String   @id @default(cuid())
  shipmentId String
  boxNumber  Int
  fbaLabel   String
  trackingId String?
  weightLb   Float?
  dimensions String?
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

enum ProductStatus {
  RESEARCHING
  SAMPLING
  APPROVED
  REJECTED
  ACTIVE
  DISCONTINUED
}

enum Incoterm {
  FOB
  EXW
  DDP
  CIF
  DAP
  FCA
}

enum SupplierStatus {
  CONTACTED
  SAMPLING
  NEGOTIATING
  APPROVED
  REJECTED
  BACKUP
}

enum ShipmentStatus {
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CHECKED_IN
  RECEIVING
  CLOSED
}


model Campaign {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name          String
  campaignType  CampaignType   @default(SPONSORED_PRODUCTS)
  targetingType TargetingType  @default(MANUAL)
  status        CampaignStatus @default(ENABLED)
  dailyBudget   Float
  startDate     DateTime?
  endDate       DateTime?
  notes         String?

  adGroups      AdGroup[]
  metrics       CampaignMetric[]
}

model AdGroup {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name       String
  defaultBid Float

  keywords   Keyword[]
}

model Keyword {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adGroupId String
  adGroup   AdGroup  @relation(fields: [adGroupId], references: [id], onDelete: Cascade)

  text         String
  matchType    MatchType     @default(BROAD)
  bid          Float
  status       KeywordStatus @default(ENABLED)
  searchVolume Int?
  source       String?

  metrics      KeywordMetric[]
}

model CampaignMetric {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  date        DateTime
  impressions Int   @default(0)
  clicks      Int   @default(0)
  spend       Float @default(0)
  sales       Float @default(0)
  orders      Int   @default(0)

  @@unique([campaignId, date])
}

model KeywordMetric {
  id        String   @id @default(cuid())
  keywordId String
  keyword   Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  date        DateTime
  impressions Int   @default(0)
  clicks      Int   @default(0)
  spend       Float @default(0)
  sales       Float @default(0)
  orders      Int   @default(0)

  @@unique([keywordId, date])
}

enum CampaignType {
  SPONSORED_PRODUCTS
  SPONSORED_BRANDS
  SPONSORED_DISPLAY
}

enum TargetingType {
  MANUAL
  AUTOMATIC
}

enum CampaignStatus {
  ENABLED
  PAUSED
  ARCHIVED
}

enum MatchType {
  BROAD
  PHRASE
  EXACT
}

enum KeywordStatus {
  ENABLED
  PAUSED
  ARCHIVED
}
